STT_WS_URL=ws://127.0.0.1:8000/ws/events
STT_JSONL_DIR=data/stt_events
STT_INGEST_MODE=ws

AUTH_STRICT=1
AUTH_SCORE_MIN=0.72
AUTH_ALLOWED_USERS=primary_user

TASK_DB_PATH=data/tasks.db
RALPH_MAX_ITERS=12
RALPH_MAX_SECONDS=180
RALPH_MODEL_ROUTING_PATH=routing.json

TTS_ENGINE=qwen3
TTS_VOICE_PROFILE_DIR=data/voices
TTS_DEFAULT_VOICE=primary_user
TTS_STREAM_FORMAT=pcm16
TTS_SAMPLE_RATE=24000
TTS_CHUNK_SENTENCES=2
